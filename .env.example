# AI Providers (server-side only — configure ao menos 1; ordem de prioridade automática)
# 1. OpenRouter Free (RECOMENDADO — gratuito, sem cartão, login Google/GitHub: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 2. Mistral Experiment Free (alternativa gratuita sem cartão: https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# 3. Cerebras Free (alternativa gratuita 1M tokens/dia sem cartão: https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# 4. Groq Free (opcional — https://console.groq.com/keys)
GROQ_API_KEY=

# 5. Google Gemini API (failover automático)
GEMINI_API_KEY=

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL (used to generate QR Code redemption links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional automation webhook (non-blocking on campaign activation)
N8N_WEBHOOK_URL=
