# Google Gemini API (server-side only — obrigatório para inferência de IA oficial;
# se indisponível ou ausente, o sistema aciona o fallback determinístico local validado pelo Zod)
GEMINI_API_KEY=

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL (used to generate QR Code redemption links)
NEXT_PUBLIC_APP_URL=https://comer-fora-up.vercel.app

# ============================================================================
# Automação Cloud — Campaign Pulse (Make.com / ferramenta agnóstica)
# Todas as variáveis abaixo são exclusivamente server-side (nunca NEXT_PUBLIC_*)
# ============================================================================

# URL do Custom Webhook do Cenário 1 no Make (prioritária; não há fallback para N8N_WEBHOOK_URL)
MAKE_WEBHOOK_URL=

# Alternativa genérica agnóstica (usada apenas se MAKE_WEBHOOK_URL estiver vazia)
# AUTOMATION_WEBHOOK_URL=

# API Key nativa enviada no header do Custom Webhook (padrão: x-make-apikey)
AUTOMATION_WEBHOOK_SECRET=
# AUTOMATION_WEBHOOK_AUTH_HEADER=x-make-apikey

# Segredo compartilhado exigido nos endpoints /api/internal/campaign-monitor*
AUTOMATION_API_SECRET=

# UUID da sessão demonstrativa controlada (cfi_session_id) — fail-closed se ausente
AUTOMATION_ALLOWED_SESSION_ID=

# Hipóteses configuráveis do Campaign Pulse (opcionais — valores padrão abaixo)
# PULSE_NO_REDEMPTIONS_MIN_HOURS=24
# PULSE_NO_REDEMPTIONS_MIN_VIEWS=5
# PULSE_LOW_CONVERSION_MIN_VIEWS=10
# PULSE_LOW_CONVERSION_MAX_PCT=15
# PULSE_BUDGET_WARNING_MIN_PCT=80
